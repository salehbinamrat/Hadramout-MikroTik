<Project>
 <PropertyGroup>
  <LangVersion>15.0</LangVersion>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  <!-- Audit direct and transitive packages on every restore, including implicit
       restores in Release builds. Keep existing fail-on-warning policy. -->
  <NuGetAudit>true</NuGetAudit>
  <NuGetAuditMode>all</NuGetAuditMode>
  <NuGetAuditLevel>low</NuGetAuditLevel>
  <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>
  <Deterministic>true</Deterministic>
 </PropertyGroup>
</Project>
